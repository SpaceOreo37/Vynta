{
  "manifest_version": 3,
  "name": "Vynta",
  "version": "1.0.0",
  "description": "Vynta: Your AI negotiator. Detects predatory brand terms and calculates fair market rates for creators.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://api.anthropic.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/libs/jspdf.umd.min.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vynta",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
